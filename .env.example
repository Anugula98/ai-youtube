# Copy to .env and fill in before running `docker compose up`.
# docker-compose.yml uses `:?` on the required ones, so it will refuse to
# start with a clear error message if you forget one.

# --- Auth (JWT) ---
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Secret encryption (YouTubeConfig credentials) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Job queue ---
REDIS_URL=redis://localhost:6379/0


# --- Postgres ---
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=              # required — generate a strong random value
POSTGRES_DB=newsroom

# --- Backend ---
# Comma-separated list of origins allowed to call the API, e.g.
# https://newsroom.example.com
CORS_ORIGINS=

# Shared-secret key required on every /api/* request (X-API-Key header).
# NOTE: this is bot/abuse deterrence, not real multi-user auth — the same
# key is baked into the frontend's env.js and is visible to anyone who loads
# the page. If you need per-user accounts/permissions, put a real auth layer
# (OAuth/JWT + a users table) in front of this before exposing it publicly.
API_KEY=

# Optional — omit to run all agents against the offline MockLLMClient.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional, this is the default

LOG_LEVEL=INFO

# Minimum fact-check score (0-100) required to advance past the FACT_CHECK
# stage; below this the pipeline blocks and loops back to RESEARCH.
# FACT_CHECK_THRESHOLD=70.0   # optional, this is the default

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Background scheduler ---
# Off by default. Safe to enable on more than one backend replica — the
# tick uses a DB-backed lock (app/scheduler_lock.py) so only one replica
# acts per tick. See app/scheduler.py's module docstring for detail.
ENABLE_SCHEDULER=false
SCHEDULER_POLL_INTERVAL_SECONDS=60

# --- Topic Discovery grounding (optional) ---
# Without this, the Discovery agent reasons from the LLM's own training-time
# knowledge. Set to ground it in real recent headlines instead. NOTE: this
# provider is a real, complete implementation but has not been exercised
# against a live key in the environment that built this scaffold — verify it
# yourself before relying on it. See agents/search_provider.py.
NEWSAPI_KEY=

# --- Frontend ---
# The PUBLIC url the browser will call — i.e. wherever you expose the
# `backend` service (through a reverse proxy/load balancer in most setups,
# not directly at container-to-container network address).
PUBLIC_BACKEND_API_URL=

# --- Ports (host side) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
